# --- PayPal (SANDBOX ONLY) -------------------------------------------------
# Create a sandbox REST app at https://developer.paypal.com/dashboard/applications/sandbox
# PAYPAL_MODE=sandbox  -> the real PayPal sandbox API (what the demo and judges use)
# PAYPAL_MODE=mock     -> in-process PayPal simulator for offline dev + automated tests ONLY
#                         (refused when NODE_ENV=production)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: enables the signed webhook endpoint (POST /api/paypal/webhook).
# Create a webhook in the sandbox app pointing at https://<your-host>/api/paypal/webhook
# subscribed to PAYMENT.CAPTURE.COMPLETED, PAYMENT.CAPTURE.DENIED, PAYMENT.CAPTURE.REFUNDED
PAYPAL_WEBHOOK_ID=

# --- AI agent ---------------------------------------------------------------
# auto (default): Gemini if GEMINI_API_KEY is set, else Claude if ANTHROPIC_API_KEY is set,
# else a rule-based fallback agent so the app still works without any AI key.
AI_PROVIDER=auto
# Google Gemini (https://aistudio.google.com/apikey). Free-tier keys have small DAILY per-model quotas:
# enable billing on the Google project for a public demo. Comma-separated list = preferred model first,
# then fallbacks tried on overload (503), quota (429) or a retired model (404).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash,gemini-3.1-flash-lite,gemini-flash-latest,gemini-3.8-flash
# Anthropic Claude (optional alternative)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Database ---------------------------------------------------------------
# Local / Render: a SQLite file (libSQL). Render's free disk is ephemeral; demo data re-seeds itself.
DATABASE_PATH=./data/mandate.db
# Vercel (or any serverless host) NEEDS a remote database: create a free Turso DB and set both.
#   turso db create mandate && turso db show mandate --url && turso db tokens create mandate
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Server -----------------------------------------------------------------
PORT=3000
# Set to production on hosted deployments (also blocks PAYPAL_MODE=mock)
NODE_ENV=development
PUBLIC_URL=http://localhost:3000
