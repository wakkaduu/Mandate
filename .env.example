# --- PayPal (SANDBOX ONLY) -------------------------------------------------
# Create a sandbox REST app at https://developer.paypal.com/dashboard/applications/sandbox
# PAYPAL_MODE=sandbox  -> real PayPal sandbox API (what the demo/judges use)
# PAYPAL_MODE=mock     -> in-process PayPal simulator for offline dev + tests
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: enables the signed webhook endpoint (POST /api/paypal/webhook).
# Create a webhook in the sandbox app pointing at https://<your-host>/api/paypal/webhook
# subscribed to PAYMENT.CAPTURE.COMPLETED, PAYMENT.CAPTURE.DENIED, PAYMENT.CAPTURE.REFUNDED
PAYPAL_WEBHOOK_ID=

# --- AI agent ---------------------------------------------------------------
# Optional. Without a key the app uses the built-in offline agent so it always demos.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Server -----------------------------------------------------------------
PORT=3000
# Where SQLite lives (Render free tier: ephemeral disk is fine, demo data re-seeds)
DATABASE_PATH=./data/mandate.db
# Public base URL (used only for display / webhook docs)
PUBLIC_URL=http://localhost:3000
