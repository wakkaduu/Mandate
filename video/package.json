{
  "name": "mandate-video",
  "version": "1.0.0",
  "private": true,
  "description": "Remotion project and ElevenLabs narration script for the Mandate demo video (see ../docs/VIDEO_BRIEF.md).",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "2.76.0",
    "@remotion/cli": "4.0.540",
    "@remotion/media-utils": "4.0.540",
    "playwright-core": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.540"
  },
  "scripts": {
    "narrate": "node --env-file=../.env scripts/narrate.mjs",
    "capture": "node --env-file=../.env scripts/capture.mjs",
    "probe": "node scripts/probe-clips.mjs",
    "studio": "node scripts/probe-clips.mjs && remotion studio src/index.jsx",
    "render": "node scripts/render.mjs"
  }
}
