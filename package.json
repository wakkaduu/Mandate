{
  "name": "mandate",
  "version": "1.0.0",
  "description": "Spend rails for AI shopping agents - every purchase is policy-checked, then settled through PayPal.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "PAYPAL_MODE=mock node --env-file-if-exists=.env --watch src/server.js",
    "test": "node --test --no-warnings \"test/*.test.js\"",
    "smoke": "node scripts/smoke.mjs",
    "postinstall": "node scripts/copy-vendor.mjs",
    "build": "node scripts/copy-vendor.mjs",
    "warm": "node scripts/warm-cache.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@libsql/client": "^0.18.0",
    "ag-grid-community": "^36.2.0",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2"
  }
}
